---
import PdfModal from '../components/PdfModal.astro';
// Base layout — Deep Research (Astro)
const { title = 'Toplina i otrovi — ENVA Sol, Vuse, JUUL, Wiip, cigarete i cigare | Deep Research', desc = 'Usporedba temperatura, emisija i biomarkera: cigarete, cigare, nepušači, JUUL, Vuse Pro One, ENVA Sol i Wiip — sinteza 130+ studija.', base = './' } = Astro.props;
---
<!doctype html>
<html lang="hr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={desc}>
<base href={base}>
<style is:global>

:root{
  --bg:#0a0a0a; --bg2:#101010; --bg3:#161412;
  --ink:rgba(255,255,255,.9); --ink2:rgba(255,255,255,.6); --ink3:rgba(255,255,255,.38);
  --amber:#ffb800; --amber2:#ff8c00;
  --cig:#e05d4f; --cigar:#b07843; --ecig:#3aa896; --vuse:#2f9e8f; --juul:#6d7fa3; --enva:#ffb800; --non:#8b94a1;
  --line:rgba(255,255,255,.12);
  --serif:Georgia,'Times New Roman',serif;
  --sans:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;
  --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.65;-webkit-font-smoothing:antialiased}
::selection{background:var(--amber);color:#000}
a{color:var(--amber);text-decoration:none;border-bottom:1px solid rgba(255,184,0,.35)}
a:hover{border-bottom-color:var(--amber)}

/* ---------- layout (docs style, full responsive) ---------- */
:root{--sbw:264px}
#outline{position:fixed;left:0;top:0;bottom:0;width:var(--sbw);overflow-y:auto;padding:2.2em 1.3em 2em;border-right:1px solid var(--line);background:var(--bg);z-index:300;overscroll-behavior:contain}
#outline .brand{font-family:var(--mono);font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--amber);margin-bottom:.6em}
#outline .brand-sub{font-size:12px;color:var(--ink3);margin-bottom:1.6em;line-height:1.5}
#outline ol{list-style:none;counter-reset:sec}
#outline ol li{margin-bottom:.15em}
#outline ol a{display:block;padding:.45em .7em;border:none;border-left:2px solid transparent;color:var(--ink2);font-size:13px;transition:all .18s}
#outline ol a::before{counter-increment:sec;content:counter(sec,decimal-leading-zero);font-family:var(--mono);font-size:10px;color:var(--ink3);margin-right:.7em}
#outline ol a:hover{color:var(--ink);border-left-color:var(--ink3)}
#outline ol a.active{color:var(--amber);border-left-color:var(--amber);background:rgba(255,184,0,.06)}
#outline .foot{margin-top:2.5em;font-size:11px;color:var(--ink3);font-family:var(--mono);line-height:1.7}
#outline .grp{font-family:var(--mono);font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink3);margin:1.6em 0 .45em;padding-left:.7em;border-top:1px solid var(--line);padding-top:1.1em}
#outline .grp:first-of-type{border-top:none;margin-top:.6em;padding-top:0}

#topbar{display:none}
#navBackdrop{display:none}

main,footer{margin-left:var(--sbw);max-width:1180px}
section{padding:4.2em clamp(1.4em,4.5vw,4.5em) 2.8em;border-bottom:1px solid var(--line)}
section,.chapter{scroll-margin-top:1.5em}

/* tablet + mobile: off-canvas navigacija + topbar */
@media (max-width:1080px){
  #topbar{display:flex;position:fixed;top:0;left:0;right:0;z-index:200;align-items:center;gap:.9em;padding:.65em 1em;background:rgba(10,10,10,.9);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
  #topbar .tb-brand{font-family:var(--mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--amber);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  #navToggle{margin-left:auto;background:var(--bg2);border:1px solid var(--line);border-radius:6px;width:44px;height:36px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;cursor:pointer}
  #navToggle span{display:block;width:18px;height:2px;background:var(--ink);transition:transform .22s,opacity .22s}
  body.nav-open #navToggle span:nth-child(1){transform:translateY(7px) rotate(45deg)}
  body.nav-open #navToggle span:nth-child(2){opacity:0}
  body.nav-open #navToggle span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
  #outline{transform:translateX(-105%);transition:transform .26s ease;padding-top:1.4em;box-shadow:24px 0 60px rgba(0,0,0,.5)}
  body.nav-open #outline{transform:none}
  #navBackdrop{display:block;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:250;opacity:0;pointer-events:none;transition:opacity .26s}
  body.nav-open #navBackdrop{opacity:1;pointer-events:auto}
  main,footer{margin-left:0}
  main{padding-top:3.1em}
  section,.chapter{scroll-margin-top:4.2em}
  section{padding:3em clamp(1.1em,4vw,2.2em) 2.2em}
  .chapter{padding:2em clamp(1.1em,4vw,2.2em) 0}
  table.data{display:block;overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch}
}
@media (max-width:640px){
  .chart{height:320px}
  .chart.tall{height:420px}
  .hero-stats{gap:1.6em 2em}
  #hero{min-height:0;padding-top:3.5em}
  #dbControls input{min-width:140px}
  #dbControls select{max-width:100%}
  .callout{padding:1.1em 1.2em}
}

/* ---------- typography ---------- */
.eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--amber);margin-bottom:1em}
h1{font-family:var(--serif);font-weight:400;font-size:clamp(34px,4.6vw,58px);line-height:1.08;letter-spacing:-.015em;margin-bottom:.5em}
h2{font-family:var(--serif);font-weight:400;font-size:clamp(26px,3vw,38px);line-height:1.15;letter-spacing:-.01em;margin-bottom:.6em}
h2 .num{font-family:var(--mono);font-size:.45em;color:var(--amber);vertical-align:super;letter-spacing:.1em;margin-right:.6em}
h3{font-size:15px;font-weight:600;letter-spacing:.02em;margin:2.2em 0 .7em;color:var(--ink)}
p{color:var(--ink2);margin-bottom:1.1em;max-width:88ch}
p strong,li strong{color:var(--ink);font-weight:600}
.lede{font-size:19px;line-height:1.6;color:var(--ink);max-width:76ch}
.small{font-size:13px;color:var(--ink3)}
ul,ol.body{ padding-left:1.2em;margin-bottom:1.2em;color:var(--ink2)}
ul li,ol.body li{margin-bottom:.5em;max-width:86ch}
blockquote{border-left:2px solid var(--amber);padding:.4em 0 .4em 1.2em;margin:1.6em 0;font-family:var(--serif);font-style:italic;color:var(--ink);font-size:17px;max-width:76ch}
.src{font-size:11px;color:var(--ink3);font-family:var(--mono);margin-top:.5em;max-width:70ch}
.src a{color:var(--ink3);border-bottom-color:rgba(255,255,255,.2)}
.src a:hover{color:var(--amber)}

/* ---------- hero ---------- */
#hero{min-height:88vh;display:flex;flex-direction:column;justify-content:center;position:relative;overflow:hidden}
#hero .rule{width:64px;height:2px;background:var(--amber);margin:2em 0}
.hero-stats{display:flex;flex-wrap:wrap;gap:2.5em 3.5em;margin-top:2.6em}
.stat .v{font-family:var(--mono);font-size:clamp(26px,3vw,40px);color:var(--amber);letter-spacing:-.02em}
.stat .l{font-size:12px;color:var(--ink3);text-transform:uppercase;letter-spacing:.14em;margin-top:.35em;max-width:22ch}
#heroCanvas{position:absolute;inset:0;z-index:-1;opacity:.55}

/* ---------- cards & tables ---------- */
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.2em;margin:1.6em 0}
.grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1.2em;margin:1.6em 0}
.card{background:var(--bg2);border:1px solid var(--line);padding:1.3em 1.4em}
.card .k{font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink3);margin-bottom:.8em}
.card .big{font-family:var(--mono);font-size:26px;letter-spacing:-.02em}
.card p{font-size:13px;margin-bottom:0}
.tag{display:inline-block;font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;padding:.25em .7em;border:1px solid var(--line);color:var(--ink2);margin:0 .4em .4em 0}
.tag.warn{border-color:rgba(255,184,0,.5);color:var(--amber)}
.tag.bad{border-color:rgba(224,93,79,.55);color:var(--cig)}
.tag.ok{border-color:rgba(58,168,150,.55);color:var(--ecig)}
table.data{width:100%;border-collapse:collapse;margin:1.4em 0;font-size:13.5px}
table.data th{font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink3);text-align:left;padding:.7em .8em;border-bottom:1px solid var(--line)}
table.data td{padding:.7em .8em;border-bottom:1px solid rgba(255,255,255,.06);color:var(--ink2);vertical-align:top}
table.data td:first-child{color:var(--ink)}
table.data tr:hover td{background:rgba(255,255,255,.02)}
table.data .n{font-family:var(--mono);color:var(--amber)}

/* ---------- charts ---------- */
#studyTable tr:target{background:rgba(255,184,0,.12)}
#studyTable tr[hidden]{display:none}
#markers table.data{table-layout:fixed;width:100%;display:table}
#markers table.data th,#markers table.data td{white-space:normal;overflow-wrap:anywhere}
#markers table.data th:first-child{width:28%}
.chart-scroll{overflow-x:auto;overscroll-behavior-x:contain}
.chart-scroll .chart{min-width:700px}
.chart-help{font-size:13px;color:var(--ink2);max-width:none}

.chart{width:100%;height:420px;margin:1.2em 0 .4em}
.chart.tall{height:520px}
.chart-note{font-size:12px;color:var(--ink3);font-family:var(--mono);margin-bottom:2em;max-width:none}

/* ---------- reveal ---------- */
.reveal{opacity:0;transform:translateY(18px);transition:opacity .6s ease,transform .6s ease}
.reveal.on{opacity:1;transform:none}

/* ---------- study db ---------- */
#dbControls{display:flex;flex-wrap:wrap;gap:.8em;margin:1.4em 0}
#dbControls input,#dbControls select{background:var(--bg2);border:1px solid var(--line);color:var(--ink);padding:.6em .9em;font-family:var(--mono);font-size:12px;outline:none}
#dbControls input{flex:1;min-width:220px}
#dbControls input:focus,#dbControls select:focus{border-color:var(--amber)}
#studyCount{font-family:var(--mono);font-size:11px;color:var(--ink3);letter-spacing:.12em;text-transform:uppercase;margin-bottom:.6em}
.pimg{background:#fff;border:1px solid var(--line);padding:12px;display:flex;align-items:center;justify-content:center;min-height:190px;margin-bottom:.9em}
.pimg img{max-width:100%;max-height:220px;object-fit:contain;display:block}
.psrc{font-family:var(--mono);font-size:10px;color:var(--ink3);margin-top:.7em;letter-spacing:.05em}

/* ---------- product image modal ---------- */
.pgal-open{position:relative;display:block;width:100%;background:none;border:0;padding:0;cursor:zoom-in}
.pgal-open img{max-width:100%;max-height:220px;object-fit:contain;display:block;margin:0 auto}
.pgal-hint{position:absolute;right:6px;bottom:6px;background:rgba(10,9,7,.82);color:var(--amber);font-family:var(--mono);font-size:10px;letter-spacing:.06em;padding:4px 8px;border:1px solid var(--amber);border-radius:2px}
#pgal{position:fixed;inset:0;z-index:600;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(8,7,5,.86);backdrop-filter:blur(8px)}
#pgal.open{display:flex}
.pg-card{position:relative;max-width:560px;width:100%;background:var(--bg2,#161412);border:1px solid var(--line);border-top:2px solid var(--amber);padding:18px 20px 16px}
#pgalX{position:absolute;top:8px;right:10px;background:none;border:0;color:var(--ink2);font-size:26px;cursor:pointer;line-height:1}
#pgalX:hover{color:var(--amber)}
.pg-title{font-family:var(--mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--amber);margin-bottom:12px}
.pg-stage{position:relative;background:#fff;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;min-height:300px}
.pg-stage img{max-width:100%;max-height:340px;object-fit:contain;display:block}
.pg-nav{position:absolute;top:50%;transform:translateY(-50%);width:38px;height:38px;background:rgba(10,9,7,.75);color:#fff;border:1px solid var(--line);font-size:20px;cursor:pointer;display:flex;align-items:center;justify-content:center}
.pg-nav:hover{border-color:var(--amber);color:var(--amber)}
.pg-prev{left:8px}.pg-next{right:8px}
.pg-cap{font-size:12px;color:var(--ink2);line-height:1.55;margin-top:12px;min-height:2.6em}
.pg-count{font-family:var(--mono);font-size:10px;color:var(--ink3);letter-spacing:.1em;text-align:right;margin-top:6px}
#studyTable td:nth-child(2){font-family:var(--mono);font-size:12px;color:var(--amber);white-space:nowrap}
#studyTable td:last-child{text-align:center;font-size:15px}
#studyTable td a:hover{color:var(--amber)}

/* ---------- callout ---------- */
.callout{background:linear-gradient(180deg,rgba(255,184,0,.07),rgba(255,184,0,.02));border:1px solid rgba(255,184,0,.3);padding:1.5em 1.6em;margin:1.8em 0}
.callout.red{background:linear-gradient(180deg,rgba(224,93,79,.08),rgba(224,93,79,.02));border-color:rgba(224,93,79,.35)}
.callout h4{font-size:13px;font-family:var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--amber);margin-bottom:.8em}
.callout.red h4{color:var(--cig)}
.callout p{max-width:none;font-size:14.5px;margin-bottom:.6em}

footer{padding:3em clamp(1.4rem,4.5vw,4.5rem) 4em;color:var(--ink3);font-size:12px}
footer p{max-width:none}
@media (max-width:1080px){footer{padding:2.5em clamp(1.1rem,4vw,2.2rem) 3em}}
footer .disc{border:1px solid var(--line);padding:1.4em 1.6em;margin-top:1.5em;line-height:1.7}

/* ---------- chapter banners & nav groups ---------- */
.chapter{margin:6em 0 0;padding:2.6em clamp(1.4em,4.5vw,4.5em) 0;border-top:2px solid var(--amber)}
.chapter .ch-k{font-family:var(--mono);font-size:11px;letter-spacing:.3em;text-transform:uppercase;color:var(--amber)}
.chapter h2{font-size:clamp(26px,3.2vw,42px);margin:.35em 0 .45em;line-height:1.12}
.chapter p{color:var(--ink2);max-width:88ch;font-size:14.5px;line-height:1.65}
#outline .grp{font-family:var(--mono);font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink3);margin:1.5em 0 .4em;padding-left:.7em}


/* ---------- glossary terms & modal ---------- */
.term{font:inherit;font-size:inherit;line-height:inherit;color:inherit;background:none;border:none;border-bottom:1px dotted var(--amber);padding:0;margin:0;cursor:help}
.term:hover,.term:focus-visible{color:var(--amber);border-bottom-style:solid;outline:none}
#gmodal{position:fixed;inset:0;z-index:500;display:flex;align-items:center;justify-content:center;padding:1em;background:rgba(0,0,0,.62);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
#gmodal[hidden]{display:none}
.gm-card{position:relative;max-width:460px;width:100%;background:var(--bg2);border:1px solid var(--line);border-top:2px solid var(--amber);padding:1.6em 1.7em;max-height:82vh;overflow-y:auto;box-shadow:0 24px 70px rgba(0,0,0,.55)}
.gm-cat{font-family:var(--mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--amber);margin-bottom:.7em}
.gm-card h3{font-size:19px;margin:0 2em .7em 0;line-height:1.25}
.gm-card p{font-size:14px;color:var(--ink2);margin-bottom:.9em}
.gm-x{position:absolute;top:.6em;right:.7em;background:none;border:1px solid var(--line);border-radius:6px;color:var(--ink2);width:34px;height:34px;cursor:pointer;font-size:17px;line-height:1}
.gm-x:hover{color:var(--amber);border-color:var(--amber)}
.gm-link{font-family:var(--mono);font-size:12px}
.gterm{background:var(--bg2);border:1px solid var(--line);padding:1.1em 1.2em;transition:border-color .35s,background .35s}
.gterm:target{border-color:var(--amber);background:rgba(255,184,0,.06)}
.gt-name{font-weight:600;font-size:14.5px;margin-bottom:.5em}
.gt-syn{font-family:var(--mono);font-weight:400;font-size:11px;color:var(--ink3);margin-left:.6em}
.gterm p{font-size:13px;margin-bottom:0}
.gt-extra{color:var(--ink3);margin-top:.5em}
</style>
<script is:inline src="js/echarts.min.js"></script>
</head>
<body>
<div id="topbar">
  <div class="tb-brand">Deep Research · duhan &amp; e-cigarete</div>
  <button id="navToggle" aria-label="Otvori navigaciju"><span></span><span></span><span></span></button>
</div>
<div id="navBackdrop"></div>
<nav id="outline">
  <div class="brand">Deep Research · 2026</div>
  <div class="brand-sub">Toplina, emisije i biomarkeri: pušači · cigare · nepušači · JUUL · Vuse Pro One · ENVA Sol — sinteza 130+ studija</div>
  <ol>
    <li class="grp">I · Svi tipovi + e-cigarete</li>
    <li><a href="#hero" class="active">Uvod i metoda</a></li>
    <li><a href="#temp">Temperatura: izgaranje</a></li>
    <li><a href="#markers">Opći markeri (CRP, COHb…)</a></li>
    <li><a href="#biomarkers">Biomarkeri kod ljudi</a></li>
    <li><a href="#cardio">Srce, krvne žile, upala</a></li>
    <li><a href="#disease">Ishodi bolesti i smrtnost</a></li>
    <li class="grp">II · Fokus: e-cig · metali · keramika</li>
    <li><a href="#emissions">Emisije, metali, keramika</a></li>
    <li><a href="#switching">Kliničke switching studije</a></li>
    <li><a href="#enva">ENVA Sol — posebna analiza</a></li>
    <li><a href="#vuse">Vuse — posebna analiza</a></li>
    <li><a href="#wiip">Wiip — posebna analiza</a></li>
    <li><a href="#market">Uređaji, cijene i nikotin</a></li>
    <li class="grp">III · Izvori</li>
    <li><a href="#db">Baza od 130+ studija</a></li>
    <li><a href="#rjecnik">Rječnik pojmova</a></li>
    <li><a href="#conclusion">Zaključak</a></li>
  </ol>
  <div class="foot">
    Izvori: PATH · NHANES · Cochrane · NEJM · PNAS · Tob Control · EHP · ACS · FDA · CDC · NASEM<br><br>
    Svi grafovi: vlastita obrada objavljenih podataka
  </div>
</nav>
<main>
<slot />
</main>
<PdfModal />


<footer>
  <p>Deep research sinteza · 8 iterativnih krugova pretrage · rujan 2026. Izvori: PATH Study (Waves 1–7), NHANES 1999–2023, Cochrane Library, NEJM, PNAS, JAMA, Tobacco Control, Environmental Health Perspectives, ACS (Chemical Research in Toxicology, ES&amp;T), Pediatrics, FDA, CDC, National Academies. Grafovi su vlastita vizualizacija objavljenih podataka; gdje je izvor procjena vlastita (ENVA snaga/temperature, kompozitni rizik), to je eksplicitno označeno.</p>
  <div class="disc"><strong>Odricanje od odgovornosti.</strong> Ovaj sadržaj služi isključivo u općeinformacijske svrhe i ne predstavlja medicinski, pravni ni profesionalni savjet. Usporedbe rizika temelje se na populacijskim dokazima i modelima koji su predmet aktivne znanstvene rasprave; dugoročni zdravstveni učinci e-cigareta nisu u potpunosti poznati. Nikotin stvara jaku ovisnost i niti jedan duhanski ili nikotinski proizvod nije siguran. Osobe koje razmišljaju o prekidu pušenja ili korištenju bilo kojeg nikotinskog proizvoda trebale bi se posavjetovati s liječnikom.</div>
</footer>
<script is:inline>
(function(){
var t=document.getElementById('navToggle'),bk=document.getElementById('navBackdrop');
if(t){t.addEventListener('click',function(){document.body.classList.toggle('nav-open');});}
if(bk){bk.addEventListener('click',function(){document.body.classList.remove('nav-open');});}
document.querySelectorAll('#outline a').forEach(function(a){a.addEventListener('click',function(){document.body.classList.remove('nav-open');});});
})();
</script>
<script is:inline src="js/charts.js"></script>
<script is:inline src="js/glossary.js"></script>
<!-- Cloudflare Web Analytics -->
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "d0e70ef913d241b2b57a95d0ea1dc4b1"}'></script>
<!-- End Cloudflare Web Analytics -->
</body>
</html>
