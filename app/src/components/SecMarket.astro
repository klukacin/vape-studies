---
import {devices,liquidContent} from '../data/devices.js';
const fmt=(n)=>n==null?'Nije potvrđeno':n.toLocaleString('hr-HR',{maximumFractionDigits:2});
---
<section id="market" class="reveal">
  <div class="eyebrow">Zajednički pregled · šest uređaja + cigarete</div>
  <h2><span class="num">12</span>Uređaji, cijene i nikotin</h2>
  <p>JUUL2, Vuse Pro One, ENVA Sol, IQOS ILUMA i ONE, Wiip Magnetic II i Wiip X Pro — šest uređaja, uz cigarete kao referencu. <a href="/#uredaji">Sve fotografije ↑</a> · zasebne analize: <a href="/#enva">ENVA Sol</a>, <a href="/#vuse">Vuse</a>, <a href="/#wiip">Wiip</a>.</p>
  <h3>Uređaj, potrošni dio i cijena</h3>
  <div class="compare-scroll"><table class="data">
    <thead><tr><th>Proizvod</th><th>Početni uređaj / kit</th><th>Potrošni dio</th><th>Tehnologija</th><th>Izvor / status</th></tr></thead>
    <tbody>{devices.map(d=><tr><th>{d.name}</th><td>{d.kit===0?'Nije potreban':d.kit==null?'Nema potvrđene EUR cijene':`${fmt(d.kit)} €`}</td><td>{d.priceLabel}</td><td>{d.heater}</td><td><a href={d.source}>{d.sourceLabel}</a></td></tr>)}</tbody>
  </table></div>
  <p class="chart-note">Vuse: službena HR početna cijena kita od 11 €; Wiip: 14,99 € / 9,99 €, provjereno 21. 9. 2026. ENVA (29 €), IQOS (39 €), cijene ostalih potrošnih dijelova i JUUL UK preuzeti su iz ranijeg cjenovnog pregleda i služe kao polazište, ne kao potvrda aktualne ponude. Kitovi nemaju isti sadržaj. Dostava nije uključena. JUUL cijenu u GBP ne pretvaramo automatski u EUR.</p>
  <h3>Početni trošak uređaja / kita</h3>
  <div class="comparison-bars" aria-label="Cijene uređaja u eurima, linearno od nule">
    {devices.map(d=><div class="comparison-row"><strong>{d.name}</strong><div class="bar-track"><span class="bar-fill" style={`width:${d.kit==null?0:d.kit/40*100}%`}></span></div><span>{d.kit==null?'Nema podatka':`${fmt(d.kit)} €`}</span></div>)}
  </div>
  <p class="chart-note">Zajednička skala 0–40 €. Cigarete: 0 € zasebnog uređaja; to nije trošak potrošnje.</p>

  <h3>Nikotin: usporedba na istoj osnovi</h3>
  <div class="compare-scroll"><table class="data">
    <thead><tr><th>Proizvod</th><th>Volumen tekućine</th><th>Koncentracija</th><th>Nikotin u tekućini cijelog poda/sticka</th><th>Prinos / ograničenje</th></tr></thead>
    <tbody>{devices.map(d=><tr><th>{d.name}</th><td>{d.volume==null?'Nije e-tekućina':`${fmt(d.volume)} mL`}</td><td>{d.strength==null?'Nije primjenjivo':`${d.strength} mg/mL`}</td><td>{liquidContent(d)==null?'Nije usporedivo na ovoj osnovi':`${fmt(liquidContent(d))} mg`}</td><td>{d.dose}</td></tr>)}</tbody>
  </table></div>
  <div class="comparison-bars" aria-label="Nikotin u tekućini, linearna skala od 0 do 40 mg">
    {devices.map(d=><div class="comparison-row"><strong>{d.name}</strong><div class="bar-track"><span class="bar-fill nicotine" style={`width:${(liquidContent(d)??0)/40*100}%`}></span></div><span>{liquidContent(d)==null?'Nije primjenjivo':`${fmt(liquidContent(d))} mg`}</span></div>)}
  </div>
  <p class="chart-note">0–40 mg, sadržaj tekućine = volumen × koncentracija. Za oba Wiipa prikazan je kompatibilni Cola 18 pod; Cola 10 i Apple 10 imaju 20 mg u 2 mL. Ovo nije doza u krvi niti usporedba štetnosti. <a href="/studije/147/">Cola 10</a> · <a href="/studije/148/">Cola 18</a> · <a href="/studije/149/">Apple 10</a> · <a href="/studije/124/">JUUL 5% literatura</a>.</p>

  <h3>Trošak po 100 puffova, mjesečno i godišnje</h3>
  <p>Odaberite scenarij potrošnje i po potrebi izmijenite cijenu ili trajnost potrošnog dijela. <strong>Isti broj puffova ne znači istu dozu nikotina.</strong> Za Wiip broj puffova po podu nije potvrđen: računica ostaje prazna dok ne unesete vlastitu pretpostavku. JUUL također traži vašu cijenu u eurima.</p>
  <form id="cost-model">
    <div class="cost-controls"><label>Puffova dnevno <input id="daily-puffs" type="number" min="0" max="10000" step="1" value="240" /></label><label>Graf prikazuje <select id="cost-period"><option value="hundred">€ / 100 puffova</option><option value="month" selected>€ / 30 dana</option><option value="year">€ / 365 dana</option></select></label><button type="reset">Vrati početne vrijednosti</button></div>
    <div class="compare-scroll"><table class="data">
      <thead><tr><th>Proizvod / računica</th><th>€ po jednom potrošnom dijelu</th><th>Puffova po tom dijelu</th><th>€ / 100 puffova</th><th>€ / 30 dana</th><th>€ / 365 dana</th><th>Ušteda / godinu prema cigaretama</th></tr></thead>
      <tbody>{devices.map(d=><tr data-cost-row={d.id}><th>{d.name}<small>{d.unit} · {d.puffNote}</small></th><td><input aria-label={`Cijena jednog potrošnog dijela: ${d.name}`} data-price type="number" min="0" max="10000" step="any" value={d.price??''} placeholder="Unesite €" /></td><td><input aria-label={`Puffova po potrošnom dijelu: ${d.name}`} data-puffs type="number" min="1" max="100000" step="1" value={d.puffs??''} placeholder="Nepoznato" /></td><td data-output="hundred">—</td><td data-output="month">—</td><td data-output="year">—</td><td data-saving>—</td></tr>)}</tbody>
    </table></div>
  </form>
  <div id="cost-bars" class="comparison-bars" aria-label="Izračun troškova, svi proizvodi na istoj linearnoj skali">
    {devices.map(d=><div class="comparison-row" data-cost-bar={d.id}><strong>{d.name}</strong><div class="bar-track"><span class="bar-fill" style="width:0%"></span></div><span data-value>Potrebni podaci</span></div>)}
  </div>
  <p id="cost-scale" class="chart-note" aria-live="polite"></p>
  <noscript><p>Za prilagodljivi izračun uključite JavaScript. Formula: trošak = cijena jednog potrošnog dijela × broj dnevnih puffova ÷ puffovi po dijelu × broj dana.</p></noscript>
  <p class="chart-note">Izračuni ne uključuju početni uređaj ni zaokruživanje na cijela pakiranja. Godina ima 365, prikazani mjesec 30 dana. „Do 1000” za Vuse predstavlja optimističnu deklariranu trajnost. ENVA je postavljena na 100 puffova po sticku; možete isprobati 200 ili 300 kao vlastite scenarije. Raniji XXL paket (69,90 € / 30 stickova) možete modelirati cijenom 2,33 € po sticku, ali paket uključuje i uređaj i nije trajna cijena nadopune.</p>
  <p>Stvarna potrošnja razlikuje se među ljudima i studijama: <a href="/studije/140/">EMIT</a>, <a href="/studije/141/">Dautzenberg</a> i <a href="/studije/142/">PATH</a>. Ovi scenariji ne pretvaraju puffove u medicinski ekvivalent cigareta. Nepoznat podatak označen je tekstom, nikad nulom.</p>
</section>
<style>
.compare-scroll{overflow-x:auto}.compare-scroll table{min-width:760px}.compare-scroll small{display:block;font-weight:400;font-size:11px;color:var(--ink2);margin-top:.5rem}
.comparison-bars{margin:1.5rem 0;display:grid;gap:1rem}.comparison-row{display:grid;grid-template-columns:180px minmax(60px,1fr) 150px;align-items:center;gap:1rem;font-size:13px}.comparison-row strong{font-weight:500}.bar-track{height:20px;border-left:1px solid #888;background:rgba(255,255,255,.025)}.bar-fill{display:block;height:100%;background:var(--amber)}.bar-fill.nicotine{background:var(--vuse)}
.cost-controls{display:flex;gap:1.2rem;flex-wrap:wrap;align-items:end;margin:1.5rem 0}label{display:grid;gap:.4rem;font-size:13px}input,select,button{background:var(--bg2);border:1px solid var(--line);color:var(--ink);padding:.6rem;font:inherit}input{width:110px}button{cursor:pointer}input:focus-visible,select:focus-visible,button:focus-visible{outline:2px solid var(--amber)}
@media(max-width:650px){.comparison-row{grid-template-columns:1fr 110px;gap:.4rem}.comparison-row strong{grid-column:1/-1}.comparison-row .bar-track{grid-column:1}.comparison-row>span{font-size:12px}}
</style>
<script>
import {costs} from '../data/devices.js';
const form=document.querySelector<HTMLFormElement>('#cost-model')!;
const rows=[...form.querySelectorAll<HTMLTableRowElement>('[data-cost-row]')];
const daily=document.querySelector<HTMLInputElement>('#daily-puffs')!;
const period=document.querySelector<HTMLSelectElement>('#cost-period')!;
const euro=(v:number)=>v.toLocaleString('hr-HR',{minimumFractionDigits:2,maximumFractionDigits:2})+' €';
function update(){
 const results=rows.map(row=>{const price=row.querySelector<HTMLInputElement>('[data-price]')!;const puffs=row.querySelector<HTMLInputElement>('[data-puffs]')!;return {row,id:row.dataset.costRow,result:price.validity.valid&&puffs.validity.valid&&daily.validity.valid?costs(price.valueAsNumber,puffs.valueAsNumber,daily.valueAsNumber):null};});
 const ref=results.find(r=>r.id==='cig')?.result;
 const key=period.value as 'hundred'|'month'|'year';
 const maximum=Math.max(1,...results.map(r=>r.result?.[key]??0));
 for(const {row,id,result} of results){
  for(const cell of row.querySelectorAll<HTMLElement>('[data-output]'))cell.textContent=result?euro(result[cell.dataset.output as 'hundred'|'month'|'year']):'Potrebni podaci';
  row.querySelector('[data-saving]')!.textContent=id==='cig'?'Referenca':result&&ref?euro(ref.year-result.year):'—';
  const bar=document.querySelector<HTMLElement>(`[data-cost-bar="${id}"]`)!;
  bar.querySelector<HTMLElement>('.bar-fill')!.style.width=result?`${result[key]/maximum*100}%`:'0%';
  bar.querySelector('[data-value]')!.textContent=result?euro(result[key]):'Potrebni podaci';
 }
 document.querySelector('#cost-scale')!.textContent=`Zajednička linearna skala od 0 do ${euro(maximum)} · ${period.selectedOptions[0].textContent}. Pozitivna ušteda znači manji trošak od scenarija cigareta.`;
}
form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('input',update);form.addEventListener('reset',()=>requestAnimationFrame(update));update();
</script>
