---
import {productGalleries} from '../data/productGalleries.js';
const {gallery,compact=false}=Astro.props;
const data=gallery==='wiip'?{title:'Wiip Magnetic II i X Pro',imgs:[...productGalleries.wiipMagnetic.imgs,...productGalleries.wiipXPro.imgs]}:productGalleries[gallery];
---
<div class:list={['inline-gallery',{compact}]} role="region" aria-label={`Fotografije: ${data.title}`}>
  <div class="slides" tabindex="0" aria-label="Listajte fotografije vodoravno">
    {data.imgs.map(([src,caption])=><figure><img src={src.startsWith('/')?src:`/${src}`} alt={caption} loading="lazy" /><figcaption>{caption}</figcaption></figure>)}
  </div>
  {data.imgs.length>1&&<div class="gallery-controls"><button type="button" data-direction="-1" aria-label={`Prethodna fotografija: ${data.title}`}>←</button><span data-counter aria-live="polite">1 / {data.imgs.length}</span><button type="button" data-direction="1" aria-label={`Sljedeća fotografija: ${data.title}`}>→</button></div>}
</div>
<style>
.inline-gallery{min-width:0;margin:1.2rem 0 2rem}.slides{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:thin}.slides figure{flex:0 0 100%;min-width:0;margin:0;scroll-snap-align:start}.slides img{display:block;width:100%;height:360px;object-fit:contain;background:#fff}.slides figcaption{padding:.8rem 0;font-size:12px;line-height:1.6;color:var(--ink2)}.compact{margin:0 0 1rem}.compact .slides img{height:240px}.compact figcaption{font-size:11px}.gallery-controls{display:flex;align-items:center;justify-content:space-between;gap:1rem;font-size:13px}.gallery-controls button{background:var(--bg2);color:var(--ink);border:1px solid var(--line);min-width:44px;min-height:44px;cursor:pointer}.gallery-controls button:disabled{opacity:.35;cursor:default}.slides:focus-visible,button:focus-visible{outline:2px solid var(--amber);outline-offset:2px}@media(max-width:600px){.slides img{height:260px}.compact .slides img{height:240px}}
</style>
<script>
for(const gallery of document.querySelectorAll<HTMLElement>('.inline-gallery')){
 const slides=gallery.querySelector<HTMLElement>('.slides')!;
 const counter=gallery.querySelector('[data-counter]');
 const buttons=[...gallery.querySelectorAll<HTMLButtonElement>('[data-direction]')];
 const count=slides.children.length;
 const current=()=>Math.round(slides.scrollLeft/Math.max(1,slides.clientWidth));
 const update=()=>{const index=current();if(counter)counter.textContent=`${index+1} / ${count}`;for(const button of buttons)button.disabled=Number(button.dataset.direction)<0?index===0:index===count-1;};
 for(const button of buttons)button.addEventListener('click',()=>slides.scrollTo({left:(current()+Number(button.dataset.direction))*slides.clientWidth,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'}));
 slides.addEventListener('scroll',update,{passive:true});
 slides.addEventListener('keydown',e=>{if(e.key==='ArrowLeft'||e.key==='ArrowRight'){e.preventDefault();slides.scrollTo({left:(current()+(e.key==='ArrowLeft'?-1:1))*slides.clientWidth});}});
 update();
}
</script>
