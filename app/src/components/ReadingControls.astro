<details class="reading-controls">
  <summary aria-label="Postavke čitanja">Aa <span>Čitanje</span></summary>
  <div class="reading-panel">
    <fieldset><legend>Tema</legend><div class="choices"><button type="button" data-theme-choice="dark">Tamna</button><button type="button" data-theme-choice="light">Svijetla</button><button type="button" data-theme-choice="soft">Blaga</button></div></fieldset>
    <fieldset><legend>Veličina teksta</legend><div class="choices"><button type="button" data-size-choice="s" aria-label="Mali tekst">S</button><button type="button" data-size-choice="m" aria-label="Srednji tekst">M</button><button type="button" data-size-choice="l" aria-label="Veliki tekst">L</button></div></fieldset>
  </div>
</details>
<style>
.reading-controls{position:fixed;right:18px;top:12px;z-index:320;font:14px var(--sans);color:var(--ink)}summary{list-style:none;cursor:pointer;background:var(--bg2);border:1px solid var(--line);padding:10px 14px;border-radius:8px;min-height:44px}summary::-webkit-details-marker{display:none}summary span{margin-left:6px}.reading-panel{position:absolute;right:0;top:52px;width:290px;background:var(--bg2);border:1px solid var(--line);border-radius:12px;padding:18px;box-shadow:0 12px 36px #0003}fieldset{border:0;margin:0 0 16px}fieldset:last-child{margin:0}legend{margin-bottom:8px;color:var(--ink2)}.choices{display:flex;gap:6px}button{flex:1;min-height:44px;padding:8px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--ink);font:inherit;cursor:pointer}button[aria-pressed=true]{border-color:var(--amber);box-shadow:inset 0 0 0 1px var(--amber);color:var(--amber)}button:focus-visible,summary:focus-visible{outline:2px solid var(--amber);outline-offset:3px}@media(max-width:1080px){.reading-controls{right:68px;top:6px}summary{padding:8px 12px;min-height:40px}summary span{display:none}.reading-panel{right:-50px;max-width:calc(100vw - 24px)}}
</style>
<script is:inline>
(()=>{
 const root=document.documentElement,control=document.querySelector('.reading-controls');
 function sync(){document.querySelectorAll('[data-theme-choice]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.themeChoice===root.dataset.theme)));document.querySelectorAll('[data-size-choice]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.sizeChoice===root.dataset.textSize)));}
 control.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.themeChoice)root.dataset.theme=b.dataset.themeChoice;if(b.dataset.sizeChoice)root.dataset.textSize=b.dataset.sizeChoice;try{localStorage.setItem('reading-preferences',JSON.stringify({theme:root.dataset.theme,size:root.dataset.textSize}));}catch{}sync();window.dispatchEvent(new Event('readingchange'));window.dispatchEvent(new Event('resize'));});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&control.open){control.open=false;control.querySelector('summary').focus();}});
 document.addEventListener('click',e=>{if(!control.contains(e.target))control.open=false;});sync();
})();
</script>
