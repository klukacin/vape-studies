---
import Base from '../layouts/Base.astro';
import STUDIES_DB from '../data/studies.js';

const cats = [...new Set(STUDIES_DB.map(s => s.cat))].sort();
---
<Base title="Baza studija — svi zapisi (135) | Deep Research" base="../">
  <section class="reveal on" id="studije">
    <div class="eyebrow">Baza znanja · {STUDIES_DB.length} zapisa</div>
    <h2><span class="num">B</span>Baza studija: svaka studija, svoj zapis, svoj izvor</h2>
    <p>Svaka studija iz baze (§11) ovdje ima vlastitu stranicu: što je mjereno, dizajn istraživanja, ključni nalaz, gdje se ti podaci koriste na stranici i izravan link na izvor. Za 42 ključne studije link je provjereni PubMed zapis (s naslovom, časopisom i DOI-jem); za regulativu i službene izvještaje vodi na primarni dokument; za ostale otvara pripremljenu Google Scholar pretragu po autoru i godini. Oznaka ♦ znači da studija ima kontrolnu grupu nepušača.</p>
    <div style="margin:1.4em 0;display:flex;gap:10px;flex-wrap:wrap">
      <input id="sdSearch" type="search" placeholder="pretraži bazu (autor, godina, nalaz, časopis…)" style="flex:1;min-width:220px">
      <select id="sdCat"><option value="">sve kategorije</option>{cats.map(c => <option value={c}>{c}</option>)}</select>
      <select id="sdNon"><option value="">sve studije</option><option value="1">♦ s kontrolom nepušača</option></select>
    </div>
    <p class="chart-note" id="sdCount">{STUDIES_DB.length} / {STUDIES_DB.length} zapisa</p>
    <table class="data" id="sdTable">
      <thead><tr><th>#</th><th>God.</th><th>Studija</th><th>Kategorija</th><th>Dizajn / izvor</th><th>Ključni nalaz</th><th>Zapis</th></tr></thead>
      <tbody id="sdBody"></tbody>
    </table>
  </section>
  <script is:inline define:vars={{ db: STUDIES_DB }}>
    const body = document.getElementById('sdBody');
    const cnt = document.getElementById('sdCount');
    const q = document.getElementById('sdSearch');
    const cat = document.getElementById('sdCat');
    const non = document.getElementById('sdNon');
    function render(){
      const needle = q.value.toLowerCase();
      const out = db.filter(s =>
        (!needle || [s.name,s.year,s.cat,s.design,s.finding,s.title||'',s.journal||''].join(' ').toLowerCase().includes(needle)) &&
        (!cat.value || s.cat === cat.value) &&
        (!non.value || s.non == 1));
      cnt.textContent = out.length + ' / ' + db.length + ' zapisa';
      body.innerHTML = out.map(s =>
        '<tr><td>'+s.i+'</td><td>'+s.year+'</td><td>'+(s.non==1?'♦ ':'')+s.name+(s.journal?'<br><small style="color:var(--ink3)">'+s.journal+'</small>':'')+'</td><td>'+s.cat+'</td><td>'+s.design+'</td><td>'+s.finding+'</td><td><a href="'+s.i+'/">otvori zapis →</a></td></tr>'
      ).join('');
    }
    [q,cat,non].forEach(el => el.addEventListener('input', render));
    render();
  </script>
</Base>
