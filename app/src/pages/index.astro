---
import Base from '../layouts/Base.astro';
import SecHero from '../components/SecHero.astro';
import SecTemp from '../components/SecTemp.astro';
import SecMarkers from '../components/SecMarkers.astro';
import SecBiomarkers from '../components/SecBiomarkers.astro';
import SecCardio from '../components/SecCardio.astro';
import SecDisease from '../components/SecDisease.astro';
import SecEmissions from '../components/SecEmissions.astro';
import SecSwitching from '../components/SecSwitching.astro';
import SecEnva from '../components/SecEnva.astro';
import SecMarket from '../components/SecMarket.astro';
import SecDb from '../components/SecDb.astro';
import SecGlossary from '../components/SecGlossary.astro';
import SecConclusion from '../components/SecConclusion.astro';
---
<Base>
<div class="chapter reveal" id="poglavlje1">
  <div class="ch-k">Poglavlje I · svi proizvodi jednim mjerilom</div>
  <h2>Cigarete, cigare, nepušači — i e-cigarete —<br>u istoj usporedbi</h2>
  <p>Ovo poglavlje stavlja <strong>sve grupe na istu ljestvicu</strong>: nepušače, pušače cigareta, pušače cigara, dualne korisnike <strong>i korisnike e-cigareta</strong>. Isti markeri, isti instrumenti: temperature izgaranja i isparavanja, opći upalni markeri (CRP, fibrinogen, leukociti, COHb), duhanski karcinogeni (NNAL), nikotin (kotinin), funkcija krvnih žila i ishodi bolesti. E-cigarete su ovdje samo jedna od grupa — bez fokusa i bez milosti.</p>
</div>
<SecHero />
<SecTemp />
<SecMarkers />
<SecBiomarkers />
<SecCardio />
<SecDisease />
<div class="chapter reveal" id="poglavlje2">
  <div class="ch-k">Poglavlje II · fokus na e-cigarete</div>
  <h2>Samo e-cigarete: metali, keramika<br>i tri konkretna uređaja</h2>
  <p>Sad kad znamo gdje su e-cigarete na ukupnoj ljestvici, otvaramo ih iznutra: <strong>koji metali izlaze iz grijača i u kojim količinama, što mijenja keramički grijač</strong> (FlavourFlow™), silikatne čestice, ulazak metala u krv i mozak, kliničke switching studije, posebna analiza ENVA Sol s EU notifikacijom — te slike, cijene i nikotin po puffu za JUUL, Vuse Pro One i ENVA Sol.</p>
</div>
<SecEmissions />
<SecSwitching />
<SecEnva />
<SecMarket />
<SecDb />
<SecGlossary />
<SecConclusion />
</Base>
